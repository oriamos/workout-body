# Copy to .env and fill in. Never commit the real file.
# Values below are placeholders.

# Required unless MCP_AUTH_DISABLED=1. Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=replace-with-a-long-random-token

# IANA timezone that decides which calendar date a workout belongs to.
WORKOUT_TIMEZONE=Asia/Jerusalem

# SQLite file. In Docker the image sets /data/training.db.
TRAINING_DB_PATH=./data/training.db

# Development only: disables authentication on /mcp and /api/v1. Leave unset.
# MCP_AUTH_DISABLED=1

# Optional upstream PWA. Unset = not served. Use a long unguessable prefix.
# WEB_BASE_PATH=/replace-with-a-secret-prefix

# For the Claude Code plugin (see plugin/workout-body/README.md)
# WORKOUT_MCP_URL=https://your-host.example/mcp
# WORKOUT_MCP_TOKEN=same-value-as-MCP_BEARER_TOKEN
