# Copy to .env and fill in; chmod 600 .env. Never commit .env.

# Required. Long random value; generate with: openssl rand -hex 32
# It unlocks the web UI login, the API and MCP. Changing it signs out every browser.
MCP_BEARER_TOKEN=

# Optional. For MCP clients that cannot send an Authorization header (e.g.
# ChatGPT custom connector with authentication "None"): /mcp then also accepts
# https://<host>/mcp?key=<MCP_URL_KEY>. Unlocks /mcp only, not the UI or API.
# Must differ from MCP_BEARER_TOKEN; generate with: openssl rand -hex 32
# Anything that logs full URLs can see it, so rotate it if it leaks.
MCP_URL_KEY=

# Local dates and weeks.
WORKOUT_TIMEZONE=Asia/Jerusalem
WORKOUT_WEEK_START=sunday

# Optional: Cloudflare Tunnel token (Cloudflare dashboard -> Zero Trust ->
# Networks -> Tunnels -> create a tunnel -> Docker -> copy the token).
# In the tunnel's "Public hostname", route your hostname to http://workout-body:8080
CLOUDFLARE_TUNNEL_TOKEN=
